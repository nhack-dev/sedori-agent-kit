# 写して .env にし、自分のキーを入れる（.env はリポジトリに入らない・誰にも渡さない）

# Amazon SP-API（自分のアカウント専用のアプリ）
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_SELLER_ID=
# 日本のマーケットプレイス
SPAPI_MARKETPLACE_ID=A1VC38T7YXB528
SPAPI_ENDPOINT=https://sellingpartnerapi-fe.amazon.com

# 楽天ウェブサービス（アプリIDとアクセスキーの両方が必須）
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# Yahoo!ショッピング（Client ID）
YAHOO_CLIENT_ID=

# Keepa（任意）
KEEPA_KEY=
